# cz_einn — .env.example
#
# Copy to `.env` and fill in. These variables are DOCUMENTATION ONLY:
# the archived notebooks contain the literal relative paths
# (`../tmp/news2016zhMin100.H`) and do NOT read environment variables.
# See README.md § "Quick start" and § "How to develop" (subsection
# "The corpus is not here").
#
# Nothing here is a secret. There are no credentials in this repository.

# Directory holding the RAW upstream corpus, i.e. the files
#   news2016zh_train.json
#   news2016zh_valid.json
# Each is line-delimited JSON objects; the text is in the "content" field.
#
# Default assumed by the notebooks: ../tmp/  (sibling of this repo)
CZ_EINN_SOURCE_DIR=../tmp

# Basename (WITHOUT extension) of the BUILT corpus pair:
#   <CZ_EINN_CORPUS>.H    raw uint16 little-endian character token IDs
#   <CZ_EINN_CORPUS>.txt  decode table: the character for each ID, in ID order
#
# Layout notes:
#   .H  -> np.memmap(path, "H")   (uint16; notebooks use "h"/int16, same bytes)
#   .txt-> np.array([open(path).read()]).view("U1")   (UTF-32, 4 bytes/char)
#
# Known vocabulary sizes: 21482 (full news2016zh charset),
#                         684   (the "Min100" reduced set used by einn5*).
#
# To build this file from the raw corpus, follow the verbatim recipe in
# README.md § "How to develop" → "Canonical regeneration recipe" (it was never scripted).
CZ_EINN_CORPUS=../tmp/news2016zhMin100

# Directory holding the CLUE-format classification JSONs used by einn3*/einn4*
# (iflytek/, tnews/, cmnli/, afqmc/, cluewsc2020/). NOT included in this repo.
CZ_EINN_CLUE_DIR=../bert/albert/CLUEdataset
